<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Tela_agendamento20">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F9F9F9"
        tools:context=".AppointmentActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!--
            <TextView
                android:id="@+id/tv_barberia_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="1. Selecionar Barbearia (RF-C07)"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Spinner
                android:id="@+id/spinner_barberia"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_barberia_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
                -->

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Agendamento de Serviço"
                android:textColor="#333333"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
                <!-- 1. Escolher Serviço -->
            <TextView
                android:id="@+id/tv_servico_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                android:text="1. Escolher Serviço"
                android:textColor="#333333"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                tools:ignore="MissingConstraints" />
            <!-- 1. Spinner servico -->
            <Spinner
                android:id="@+id/spinner_servico"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_servico_label" />
            <!-- 2. Escolher Barbeiro -->
            <TextView
                android:id="@+id/tv_barbeiro_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="2. Escolher Barbeiro "
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/spinner_servico"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <!-- Spinner Barbeiro -->
            <Spinner
                android:id="@+id/spinner_barbeiro"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_barbeiro_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <!-- 3. selecionar data e horario -->
            <TextView
                android:id="@+id/tv_data_hora_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="3. Selecionar Data e Horário"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/spinner_barbeiro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <!-- Button data -->
            <Button
                android:id="@+id/button_selecionar_data_hora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Selecionar Data e Ver Horários"
                android:layout_marginTop="8dp"
                android:backgroundTint="#CCCCCC"
                android:textColor="#333333"
                app:layout_constraintTop_toBottomOf="@id/tv_data_hora_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <!-- Mostrar horario -->
            <TextView
                android:id="@+id/tv_horario_selecionado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Horário selecionado: --/--/----, --:--"
                android:layout_marginTop="12dp"
                android:textColor="#666666"
                app:layout_constraintTop_toBottomOf="@id/button_selecionar_data_hora"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <!-- Button confirmar -->
            <Button
                android:id="@+id/button_confirmar_agendamento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Confirmar Agendamento "
                android:layout_marginTop="40dp"
                android:backgroundTint="#007BFF"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/tv_horario_selecionado"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <!-- button ver agendamentos -->
            <Button
                android:id="@+id/button_ver_agendamentos"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ver Meus Agendamentos Futuros"
                android:textColor="#007BFF"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/button_confirmar_agendamento"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <!-- button cancelar -->
            <Button
                android:id="@+id/button_cancelar"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Cancelar agendamento"
                android:textColor="#F44336"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/button_ver_agendamentos"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>