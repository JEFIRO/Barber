<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="14dp"
    android:background="@color/primary_light"
    android:elevation="8dp"
    android:radius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rounded"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/cardImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/background_rounded"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_barba" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="3dp"
                android:text="Corte + Barba Premium"
                android:textColor="@color/blackPremium"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cardDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Navalha, tesoura, massagem facial e finalização."
                android:textColor="@color/blackPremium"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/cardPreco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="R$ 50,00"
                    android:textColor="@color/blackPremium"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cardDuracao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="30 Min"
                    android:textColor="@color/blackPremium"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAgendar"
                style="@style/BarberButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Agendar Horário" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
